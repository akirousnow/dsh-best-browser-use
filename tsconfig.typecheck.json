{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"]
  },
  "include": [
    "packages/protocol/src/**/*.ts",
    "packages/relay/src/**/*.ts",
    "packages/engine/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/extension/src/**/*.ts",
    "tests/**/*.ts"
  ]
}
